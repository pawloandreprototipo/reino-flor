{
  "name": "reino-flor",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm --filter './packages/*' build && pnpm --filter './apps/*' build",
    "test": "pnpm --recursive test",
    "db:generate": "pnpm --filter @reino-flor/database db:generate",
    "db:migrate": "pnpm --filter @reino-flor/database db:migrate",
    "db:seed": "pnpm --filter @reino-flor/database db:seed",
    "db:studio": "pnpm --filter @reino-flor/database db:studio",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
